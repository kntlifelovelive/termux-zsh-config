#!/usr/bin/env bash
# Termux Zsh Config installer — copy-based, Termux-only.
# Usage: ./install
#
# This installer is dedicated to native Android Termux. It does NOT support
# desktop Linux distributions, and it does not require the reference repo.
set -u

# ------------------------------------------------------------------ palette
RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
BLUE='\033[34m'
CYAN='\033[36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

err()   { printf '%bERROR:%b %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }
warn()  { printf '%bWARN:%b %s\n' "$YELLOW" "$RESET" "$*" >&2; }
ok()    { printf '      %b✓%b %s\n' "$GREEN" "$RESET" "$1"; }
info()  { printf '      %b%s%b\n' "$DIM" "$1" "$RESET"; }
stage() { printf '\n%b[%s]%b %b%s%b\n' "$BOLD$CYAN" "$1" "$RESET" "$BOLD" "$2" "$RESET"; }

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SRC_DIR="$SCRIPT_DIR/zsh"
SRC_ZSHENV="$SCRIPT_DIR/.zshenv"
PLUGINS_DIR="$HOME/.zsh/plugins"

# ------------------------------------------------------------------ packages
# Required by the default enabled features:
#   zsh        — the shell itself
#   git        — needed to clone the plugin files
#   eza        — default 'ls' replacement (aliases e/ea/el/…)
#   fzf        — default file/folder finder keybindings (Ctrl+T / Ctrl+F)
#   zoxide     — default smarter-cd ('z' integration)
#   micro      — default editor (aliased to 'n')
#
# Genuinely optional tools (enhancements, never installed automatically):
#   curl, bat, ripgrep, fd, vim, procps
#   termux-api — required for zsh-system-clipboard clipboard integration
REQUIRED_CMDS=(zsh git eza fzf zoxide micro)
OPTIONAL_CMDS=(curl bat ripgrep fd vim procps termux-api)

# Map a command name to its Termux package name.
pkg_for() {
    case "$1" in
        zsh)        echo zsh ;;
        git)        echo git ;;
        eza)        echo eza ;;
        fzf)        echo fzf ;;
        zoxide)     echo zoxide ;;
        micro)      echo micro ;;
        curl)       echo curl ;;
        bat)        echo bat ;;
        ripgrep)    echo rg ;;
        fd)         echo fd-find ;;
        vim)        echo vim ;;
        procps)     echo procps ;;
        termux-api) echo termux-api ;;
        *)          echo "$1" ;;
    esac
}

# --------------------------------------------------------------- [1/9] Termux
stage "1/9" "Verifying Termux environment..."

is_termux=0
[[ -n "${TERMUX_VERSION:-}" ]]         && is_termux=1
[[ -d /data/data/com.termux ]]         && is_termux=1
command -v pkg >/dev/null 2>&1         && is_termux=1

if [[ $is_termux -eq 0 ]]; then
    err "This installer is for native Termux only. Not running in Termux."
fi

[[ -n "${HOME:-}" && "$HOME" == /* && "$HOME" != "/" ]] ||
    err "HOME is not set to a valid user directory."
(( EUID != 0 )) ||
    err "Run the installer as a normal user, not as root."

ok "Termux environment detected"

# ----------------------------------------------------------- [2/9] Dependencies
stage "2/9" "Checking dependencies..."

missing_required=()
for cmd in "${REQUIRED_CMDS[@]}"; do
    command -v "$cmd" >/dev/null 2>&1 || missing_required+=("$(pkg_for "$cmd")")
done

missing_optional=()
for cmd in "${OPTIONAL_CMDS[@]}"; do
    command -v "$cmd" >/dev/null 2>&1 || missing_optional+=("$(pkg_for "$cmd")")
done

# Install only missing required packages. Never run 'pkg upgrade'.
if [[ ${#missing_required[@]} -gt 0 ]]; then
    info "Installing required packages: ${missing_required[*]}"
    pkg install -y "${missing_required[@]}" ||
        err "Package installation failed: ${missing_required[*]}"
fi

# Verify required packages (fail loudly — never fake a PASS).
for cmd in "${REQUIRED_CMDS[@]}"; do
    command -v "$cmd" >/dev/null 2>&1 ||
        err "$cmd ($(pkg_for "$cmd")) is required but unavailable after installation."
done
ok "Required packages present: ${REQUIRED_CMDS[*]}"

# Optional packages: report but never install automatically.
if [[ ${#missing_optional[@]} -gt 0 ]]; then
    warn "Optional packages not installed: ${missing_optional[*]}"
    info "Install them later with: pkg install ${missing_optional[*]}"
    info "The configuration works without them — every feature is guarded."
else
    ok "Optional packages present: ${OPTIONAL_CMDS[*]}"
fi

# ------------------------------------------------------- [3/9] Validate source
stage "3/9" "Validating source configuration..."

src_fail=0
src_count=0
while IFS= read -r f; do
    src_count=$((src_count + 1))
    if ! zsh -n "$f" 2>/dev/null; then
        echo "ERROR: Configuration validation failed: $f" >&2
        src_fail=1
    fi
done < <(find "$SRC_DIR" \( -name '*.zsh' -o -name '.zshrc' \) -type f)
(( src_fail == 0 )) || exit 1
ok "Source OK ($src_count files passed zsh -n)"

# --------------------------------------------------- [4/9] Backup + copy
stage "4/9" "Creating backup and installing..."

TARGET="$HOME/.config/zsh"
BACKUP="(none — no existing configuration)"
stamp="$(date +%Y%m%d-%H%M%S)"

if [[ -e "$HOME/.zshenv" || -e "$TARGET" ]]; then
    BACKUP="$HOME/.config/zsh-backup-$stamp"
    n=1
    while [[ -e "$BACKUP" ]]; do
        n=$((n + 1))
        BACKUP="$HOME/.config/zsh-backup-$stamp-$n"
    done
    mkdir -p "$BACKUP" || err "Could not create backup directory."
    if [[ -e "$HOME/.zshenv" ]]; then
        cp -a "$HOME/.zshenv" "$BACKUP/.zshenv" || err "Backup of .zshenv failed."
    fi
    if [[ -e "$TARGET" ]]; then
        cp -a "$TARGET" "$BACKUP/zsh" || err "Backup of config dir failed."
    fi
    ok "Backup created: $BACKUP"
else
    info "No existing configuration — backup not needed"
fi

# Copy-based install (never symlinks): stage first, then activate.
mkdir -p "$HOME/.config" || err "Could not create ~/.config."
STAGE="$HOME/.config/.zsh-new.$$"
rm -rf "$STAGE"
cp -a "$SRC_DIR" "$STAGE" || { rm -rf "$STAGE"; err "Copy failed."; }
rm -rf "$TARGET"
mv "$STAGE" "$TARGET" || err "Could not activate configuration."
cp -a "$SRC_ZSHENV" "$HOME/.zshenv" || err "Could not write ~/.zshenv."

ok "Installed: $TARGET"
ok "Installed: $HOME/.zshenv"

# ------------------------------------------------------- [5/9] Install plugins
stage "5/9" "Installing Zsh plugins..."

# Plugins are cloned into $PLUGINS_DIR ($HOME/.zsh/plugins), which lives
# outside $TARGET ($HOME/.config/zsh) so they survive config replacement.

# name | repository url | file that must exist once installed
install_plugin() {
    local name="$1" url="$2" expected="$3"
    local dir="$PLUGINS_DIR/$name"

    if [[ -f "$dir/$expected" ]]; then
        ok "$name already installed"
        return 0
    fi

    if [[ -d "$dir" ]]; then
        # Directory exists but the plugin file is missing: repair in place,
        # never reclone over an existing installation.
        if [[ -d "$dir/.git" ]]; then
            info "$name: incomplete installation, updating..."
            git -C "$dir" pull -q --ff-only ||
                err "$name: existing installation at $dir is incomplete and could not be updated."
        else
            err "$name: $dir exists but is not a valid plugin installation."
        fi
    else
        command -v git >/dev/null 2>&1 || err "git is required to install $name."
        info "Cloning $name..."
        mkdir -p "$PLUGINS_DIR" || err "Cannot create $PLUGINS_DIR."
        git clone -q "$url" "$dir" ||
            err "$name: clone failed ($url)."
    fi

    [[ -f "$dir/$expected" ]] ||
        err "$name: expected file $dir/$expected is still missing."
    ok "$name installed"
}

install_plugin zsh-syntax-highlighting \
    https://github.com/zsh-users/zsh-syntax-highlighting.git \
    zsh-syntax-highlighting.zsh
install_plugin zsh-autosuggestions \
    https://github.com/zsh-users/zsh-autosuggestions.git \
    zsh-autosuggestions.zsh
install_plugin zsh-system-clipboard \
    https://github.com/kutsan/zsh-system-clipboard.git \
    zsh-system-clipboard.zsh

# ----------------------------------------------- [6/9] Validate installed
stage "6/9" "Validating installed configuration..."

inst_fail=0
inst_count=0
while IFS= read -r f; do
    inst_count=$((inst_count + 1))
    if ! zsh -n "$f" 2>/dev/null; then
        echo "ERROR: Configuration validation failed: $f" >&2
        inst_fail=1
    fi
done < <(find "$TARGET" \( -name '*.zsh' -o -name '.zshrc' -o -name '.zshenv' \) -type f)
# Also validate the deployed .zshenv.
if [[ -f "$HOME/.zshenv" ]] && ! zsh -n "$HOME/.zshenv" 2>/dev/null; then
    echo "ERROR: Configuration validation failed: $HOME/.zshenv" >&2
    inst_fail=1
    inst_count=$((inst_count + 1))
fi
(( inst_fail == 0 )) || exit 1
ok "zsh -n passed ($inst_count installed files)"

# Non-blocking startup test (stdin from /dev/null so it can never block).
startup_err="$(env -u ZDOTDIR timeout 30 zsh -lic 'exit' </dev/null 2>&1 >/dev/null)"
startup_rc=$?
if [[ $startup_rc -ne 0 ]] || [[ -n "$startup_err" ]]; then
    [[ -z "$startup_err" ]] || printf '%s\n' "$startup_err" >&2
    err "Startup test failed (RC=$startup_rc)."
fi
ok "Startup test passed (RC=0, stderr empty)"

# ----------------------------------------------- [7/9] Default login shell
stage "7/9" "Setting Zsh as the default login shell..."

# Determine the zsh path robustly: prefer command -v zsh (avoids $PREFIX
# path-doubling on setups where $PREFIX already ends in /bin).
if command -v zsh >/dev/null 2>&1; then
    ZSH_PATH="$(command -v zsh)"
else
    ZSH_PATH="$PREFIX/bin/zsh"
fi
# Normalize: collapse any double slashes.
ZSH_PATH="${ZSH_PATH//\/\///}"

# Ensure Zsh is installed and executable at the resolved path.
if [[ ! -x "$ZSH_PATH" ]]; then
    warn "Zsh not executable at $ZSH_PATH — skipping default shell setup."
    info "Recovery: install zsh (pkg install zsh), then run: chsh -s \"$ZSH_PATH\""
else
    # Detect current login shell.
    current_shell="${SHELL:-}"
    if [[ -z "$current_shell" && -n "${USER:-}" ]]; then
        current_shell="$(getent passwd "$USER" 2>/dev/null | awk -F: '{print $7}' || true)"
    fi

    # Verify zsh is listed in shells file if available (Termux: $PREFIX/etc/shells).
    shells_file=""
    if [[ -f "$PREFIX/etc/shells" ]]; then
        shells_file="$PREFIX/etc/shells"
    elif [[ -f /etc/shells ]]; then
        shells_file="/etc/shells"
    fi
    if [[ -n "$shells_file" ]] && ! grep -qx "$ZSH_PATH" "$shells_file" 2>/dev/null; then
        warn "$ZSH_PATH is not listed in $shells_file — chsh may reject it."
        info "Recovery: add '$ZSH_PATH' to '$shells_file', then run: chsh -s \"$ZSH_PATH\""
    fi

    if [[ "$current_shell" == "$ZSH_PATH" ]]; then
        ok "Default shell is already Zsh ($ZSH_PATH)"
    elif [[ -z "$current_shell" ]]; then
        warn "Could not detect current login shell — skipping shell change."
        info "Recovery: run 'chsh -s \"$ZSH_PATH\"' manually to set Zsh as your login shell."
    elif ! command -v chsh >/dev/null 2>&1; then
        warn "chsh command not available — skipping default shell setup."
        info "Recovery: install termux-tools, then run: chsh -s \"$ZSH_PATH\""
    else
        # Ask for confirmation before changing the login shell.
        # In non-interactive runs (tests, piped stdin) default to 'N' unless
        # BUBU_INSTALL_CONFIRM_SHELL is set.
        printf '\n%b?%b Change default login shell to Zsh?\n' "$BOLD$YELLOW" "$RESET"
        printf '  Current: %s\n' "$current_shell"
        printf '  Target:  %s\n' "$ZSH_PATH"
        if [[ -t 0 && -z "${BUBU_INSTALL_CONFIRM_SHELL:-}" ]]; then
            printf '  %b[y/N]%b ' "$BOLD" "$RESET"
            read -r confirm
        elif [[ -n "${BUBU_INSTALL_CONFIRM_SHELL:-}" ]]; then
            confirm="$BUBU_INSTALL_CONFIRM_SHELL"
            info "Confirm via BUBU_INSTALL_CONFIRM_SHELL: $confirm"
        else
            confirm="N"
            info "Non-interactive run — defaulting to 'N' (no shell change)."
        fi
        confirm="${confirm:-N}"

        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            if chsh -s "$ZSH_PATH" 2>/dev/null; then
                ok "Default shell changed to Zsh ($ZSH_PATH)"
                info "The change takes effect in new login sessions (not this one)."
            else
                shell_rc=$?
                warn "Shell change failed (chsh exit code $shell_rc)."
                info "Recovery steps:"
                info "  1. Ensure zsh is installed:   pkg install zsh"
                info "  2. Ensure $ZSH_PATH is executable."
                info "  3. Ensure $ZSH_PATH is listed in your shells file ($shells_file)."
                info "  4. Run manually:  chsh -s \"$ZSH_PATH\""
            fi
        else
            info "Shell change skipped by user — configuration still installed."
            info "To set Zsh manually later:  chsh -s \"$ZSH_PATH\""
        fi
    fi
fi

# ------------------------------------------------------------------ [8/9] Done
stage "8/9" "Complete"
echo
printf '  %bConfig :%b %s\n' "$BOLD" "$RESET" "$TARGET"
printf '  %bZshenv :%b %s\n' "$BOLD" "$RESET" "$HOME/.zshenv"
printf '  %bPlugins :%b %s\n' "$BOLD" "$RESET" "$PLUGINS_DIR"
printf '  %bBackup :%b %s\n' "$BOLD" "$RESET" "$BACKUP"
echo
info "Restore procedure:"
info "  cp -a \"$BACKUP/.zshenv\" \"$HOME/.zshenv\""
info "  cp -a \"$BACKUP/zsh\" \"$HOME/.config/zsh\""
echo
info "Start a new zsh session to use the configuration."
info "Optional packages: pkg install ${OPTIONAL_CMDS[*]}"
echo
info "The installer does NOT change your default shell without your confirmation."
info "If you declined, run 'chsh -s \"$(command -v zsh)\"' manually when ready."
exit 0
